# Copy this file to .env and edit it for your machine.
# NEVER commit .env (it is already in .gitignore): it contains your database password.

DJANGO_DEBUG=True
# Generate a new key:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database name created by sql/horse_v2.sql
DB_NAME=RacehorseTrainingManagement
# Same as the "Server name" box when you log in to SSMS
DB_HOST=localhost\SQLEXPRESS
DB_PORT=
# Leave DB_USER empty to use Windows Authentication (SSMS default)
DB_USER=
DB_PASSWORD=
# Use the driver installed on your machine: "ODBC Driver 18 for SQL Server" or "ODBC Driver 17 for SQL Server"
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
DB_EXTRA_PARAMS=TrustServerCertificate=yes

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Uploaded files ----------
# Folder for uploaded horse documents (default: media/ next to manage.py). Max size per file in MB.
MEDIA_ROOT=
UPLOAD_MAX_MB=10

# ---------- Email (Gmail) ----------
# Leave empty: emails are only printed in the backend window (good for demo).
# To really send: turn on 2-Step Verification for the Gmail account, create an "App password"
# (Google Account > Security > App passwords) and paste the 16 characters below. Never commit it.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Link printed at the bottom of every email
FRONTEND_URL=http://localhost:5173

# ---------- Sign in with Google ----------
# Google Cloud Console > APIs & Services > Credentials > Create OAuth client ID (Web application),
# Authorized JavaScript origins: http://localhost:5173 . Put the SAME value in frontend/.env as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
